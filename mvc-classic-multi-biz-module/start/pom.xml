<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.structure.multibizmodule</groupId>
        <artifactId>mvc-classic-multi-biz-module</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>start</artifactId>
    <name>start</name>
    <description>装配与启动模块：唯一含 @SpringBootApplication/main/boot 插件的模块</description>

    <dependencies>
        <dependency>
            <groupId>com.example.structure.multibizmodule</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.structure.multibizmodule</groupId>
            <artifactId>user-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.structure.multibizmodule</groupId>
            <artifactId>org-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.structure.multibizmodule</groupId>
            <artifactId>salary-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
